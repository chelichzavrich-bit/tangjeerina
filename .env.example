# обязательное
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=            # можно несколько через запятую в GEMINI_API_KEYS
CRON_SECRET=
BOT_USERNAME=tangjeebot
TELEGRAM_WEBHOOK_SECRET=   # если задан - добавить &secret_token= в setWebhook

# память (Upstash подключается сам, вручную не нужно)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# модели
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_THINKING_LEVEL=     # minimal|low|medium|high, пусто = авто
GEMINI_SAFETY=BLOCK_ONLY_HIGH
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# поведение
WORK_BUDGET_MS=45000
HISTORY_MAX_MESSAGES=60
COOLDOWN_SECONDS=240
SPONTANEOUS_PER_HOUR=6
REACT_STRONG=0.75
SPONTANEOUS_CHANCE=0.4
REACT_TOPIC=0.2
REACT_LINK=0.3
REACT_PHOTO=0.3
REACT_JOIN=0.8
REACT_RANDOM=0.04
REPLY_IN_GROUP=on
VOICE_MOCK=on
REACTIONS=on
STICKERS=on
LINK_PARSING=on
SEARCH=on
MARKET=on
DOX=on
CODES=on

# пульс
SILENCE_HOURS=12
PULSE_TZ=Etc/GMT+5
PULSE_QUIET_HOURS=1-8
PULSE_MAX_CHATS_PER_RUN=3
PULSE_MAX_UNANSWERED=2
CRON_CHAT_ID=
VOICE_EVERY_HOURS=48
DAILY_VOICE_FILE_ID=
VOICE_PING_CHAT_ID=
VOICE_PING_TARGETS=
