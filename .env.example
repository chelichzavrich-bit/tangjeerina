# ───── Обязательные ─────
TELEGRAM_BOT_TOKEN=токен_от_BotFather
GEMINI_API_KEY=ключ_из_Google_AI_Studio
CRON_SECRET=длинная_случайная_строка_минимум_16_символов

# ───── Память и «живой» режим (бесплатный Upstash Redis через Vercel Marketplace) ─────
# Эти две переменные Vercel добавит сам при подключении Upstash Redis к проекту
# (названия могут быть KV_REST_API_URL / KV_REST_API_TOKEN - код понимает оба варианта):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───── Необязательные ─────
CRON_CHAT_ID=123456789            # чаты, куда писать проактивно даже без истории (через запятую)
TELEGRAM_WEBHOOK_SECRET=          # тот же secret_token, что в setWebhook
BOT_USERNAME=                     # username бота без @: в группах отвечать только на упоминание/ответ
GEMINI_MODEL=                     # своя модель, пробуется первой

HISTORY_MAX_MESSAGES=40           # сколько последних реплик помнить (40 = 20 пар)
MEMORY_TTL_HOURS=72               # через сколько часов тишины чат «забывается»
MAX_OUTPUT_TOKENS=1200            # потолок длины ответа
MAX_FILE_MB=10                    # макс. размер вложения
MAX_DOC_CHARS=30000               # макс. символов текста из DOCX/TXT

PULSE_MIN_MINUTES=30              # мин. пауза до сообщения «от себя»
PULSE_MAX_MINUTES=240             # макс. пауза
PULSE_QUIET_HOURS=1-8             # тихие часы (по PULSE_TZ), пусто = писать круглосуточно
PULSE_TZ=Europe/Berlin            # часовой пояс для тихих часов (по умолчанию UTC)
PULSE_MAX_UNANSWERED=2            # сколько раз подряд писать, если никто не отвечает
PULSE_MAX_CHATS_PER_RUN=3         # сколько чатов обслуживать за один вызов
PULSE_ACTIVE_DAYS=14              # чат считается активным, если в нём писали за N дней

# ───── Чтение ссылок (YouTube, Telegram, сайты, картинки) ─────
LINK_PARSING=on                   # off - полностью отключить чтение ссылок
YOUTUBE_API_KEY=                  # НЕОБЯЗАТЕЛЬНО. Без ключа бот берёт название/канал через oEmbed и описание/теги со страницы видео.
                                  # С ключом (YouTube Data API v3, бесплатная квота 10 000 единиц/сутки, 1 запрос = 1 единица) данные надёжнее.
MAX_LINKS_PER_MESSAGE=2           # сколько ссылок из одного сообщения читать
LINK_TIMEOUT_MS=5000              # общий таймаут на одну ссылку (минимум 1000)
LINK_TEXT_CHARS=500               # сколько символов текста статьи отдавать модели
LINK_MAX_IMAGE_MB=5               # макс. размер картинки по ссылке
