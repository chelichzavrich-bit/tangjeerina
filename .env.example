# ───── Обязательные ─────
TELEGRAM_BOT_TOKEN=токен_от_BotFather
GEMINI_API_KEY=ключ_из_Google_AI_Studio
CRON_SECRET=длинная_случайная_строка_минимум_16_символов

# ───── Память и «живой» режим (бесплатный Upstash Redis через Vercel Marketplace) ─────
# Эти две переменные Vercel добавит сам при подключении Upstash Redis к проекту
# (названия могут быть KV_REST_API_URL / KV_REST_API_TOKEN - код понимает оба варианта):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───── Необязательные ─────
CRON_CHAT_ID=123456789            # чаты, куда писать проактивно даже без истории (через запятую)
TELEGRAM_WEBHOOK_SECRET=          # тот же secret_token, что в setWebhook
BOT_USERNAME=                     # НЕ обязательно: бот сам узнаёт своё имя у Telegram
GEMINI_MODEL=                     # своя модель, пробуется первой

HISTORY_MAX_MESSAGES=60           # сколько последних реплик ЧАТА помнить (всех участников и Танг)
MEMORY_TTL_HOURS=336              # через сколько часов тишины чат «забывается» (336 = 14 дней)
MAX_OUTPUT_TOKENS=1200            # потолок длины ответа
MAX_FILE_MB=10                    # макс. размер вложения
MAX_DOC_CHARS=30000               # макс. символов текста из DOCX/TXT

# ───── «Участница чата, но не спамит» (всё необязательно, значения по умолчанию подобраны) ─────
COOLDOWN_SECONDS=240              # после любой её реплики столько секунд она сама не вклинивается
SPONTANEOUS_PER_HOUR=6            # максимум самопроизвольных реплик в час на один чат
REACT_STRONG=0.75                 # шанс ответить без пинга на громкое слово (Жак, ЛНР, харза, дракон...)
SPONTANEOUS_CHANCE=0.4            # шанс для слабых слов (деньги, звезда, лампа...)
REACT_TOPIC=0.2                   # шанс для тем (крипта, коммунизм, любовь...)
REACT_LINK=0.3                    # шанс прокомментировать ссылку без пинга
REACT_PHOTO=0.3                   # шанс прокомментировать фото без пинга
REACT_JOIN=0.8                    # шанс поприветствовать новичка
REACT_RANDOM=0.04                 # шанс вклиниться в любое сообщение просто так
# (на прямое обращение - @бот, ответ на её сообщение, имя «Танг», личка - отвечает ВСЕГДА)

# ───── Пишет сама, когда тихо ─────
SILENCE_HOURS=12                  # тишина дольше N часов = повод написать
PULSE_QUIET_HOURS=1-8             # тихие часы (по PULSE_TZ), пусто = писать круглосуточно
PULSE_TZ=Europe/Berlin            # часовой пояс чата для тихих часов
PULSE_MAX_UNANSWERED=2            # сколько раз подряд писать в мёртвый чат, если никто не отвечает
PULSE_MAX_CHATS_PER_RUN=3         # сколько чатов обслуживать за один вызов
PULSE_ACTIVE_DAYS=14              # чат считается живым, если в нём писали за N дней

# ───── Голосовой пинг раз в ~2 дня ─────
DAILY_VOICE_FILE_ID=              # file_id заготовленного голосового (можно несколько через запятую - выберет случайное)
VOICE_PING_CHAT_ID=               # ID чата(ов) для голосовых. Пусто = все активные группы
VOICE_PING_TARGETS=               # необязательно: доп. ID пользователей, кого можно пинговать (кроме тех, кого бот видел в чате)
VOICE_EVERY_HOURS=48              # интервал между голосовыми

# ───── Чтение ссылок (YouTube, Telegram, сайты, картинки) ─────
LINK_PARSING=on                   # off - полностью отключить чтение ссылок
YOUTUBE_VIDEO_SECONDS=120          # сколько секунд ролика YouTube Gemini реально «смотрит» (0 = только название/описание)
YOUTUBE_API_KEY=                  # НЕОБЯЗАТЕЛЬНО. Без ключа бот берёт название/канал через oEmbed и описание/теги со страницы видео.
                                  # С ключом (YouTube Data API v3, бесплатная квота 10 000 единиц/сутки, 1 запрос = 1 единица) данные надёжнее.
MAX_LINKS_PER_MESSAGE=2           # сколько ссылок из одного сообщения читать
LINK_TIMEOUT_MS=5000              # общий таймаут на одну ссылку (минимум 1000)
LINK_TEXT_CHARS=500               # сколько символов текста статьи отдавать модели
LINK_MAX_IMAGE_MB=5               # макс. размер картинки по ссылке
