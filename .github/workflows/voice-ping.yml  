name: Voice Ping Trigger

on:
  schedule:
    - cron: '0 */5 * * *'
  workflow_dispatch:

# Добавь это:
concurrency:
  group: voice-ping-${{ github.ref }}
  cancel-in-progress: false

jobs:
  trigger-pulse:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Vercel Pulse Endpoint
        run: |
          curl -X POST "${{ secrets.PULSE_URL }}" \
            -H "Authorization: Bearer ${{ secrets.CRON_SECRET }}" \
            -H "Content-Type: application/json" \
            -d '{"type": "voice"}'
