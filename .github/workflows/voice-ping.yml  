name: Voice Ping Trigger

on:
  schedule:
    # Запуск каждые 5 часов: 00:00, 05:00, 10:00, 15:00, 20:00 по UTC
    - cron: '0 */5 * * *'
  workflow_dispatch: # Ручной запуск для тестирования

concurrency:
  group: voice-ping-${{ github.ref }}
  cancel-in-progress: false

jobs:
  trigger-pulse:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Vercel Pulse Endpoint
        run: |
          curl -X POST "${{ secrets.PULSE_URL }}" \
            -H "Authorization: Bearer ${{ secrets.CRON_SECRET }}" \
            -H "Content-Type: application/json" \
            -d '{"type": "voice"}'
