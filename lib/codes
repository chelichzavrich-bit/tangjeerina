];

function parseCommand(text) {
  const m = /^\/(code|код|шифр|cipher)(?:@(\w+))?(?:_([A-Za-zА-Яа-яЁё0-9]+))?\s*([\s\S]*)$/i.exec(String(text || '').trim());
  if (!m) return null;
  const rest = String(m[4] || '').trim();
  let parsed = parseCipherToken(m[3]);
  let cipher = parsed.key;
  let shift = parsed.shift;
  let payload = rest;
  if (!cipher && rest) {
    const first = rest.split(/\s+/)[0];
    const guess = parseCipherToken(first);
    if (guess.key) {
      cipher = guess.key;
      shift = guess.shift;
      payload = rest.slice(first.length).trim();
    }
  }
  // /code_caesar 5 текст - сдвиг отдельным числом
  if (cipher === 'caesar' && payload) {
    const sm = /^(\d{1,2})\s+([\s\S]+)$/.exec(payload);
    if (sm) { shift = clampShift(sm[1]); payload = sm[2].trim(); }
  }
  return { cipher, shift, payload, bot: (m[2] || '').toLowerCase() };
}

function resolve(cipher, payload, shift) {
  if (cipher) return apply(cipher, payload, null, shift);
  const d = detect(payload);
  return d ? apply(d.cipher, payload, 'decode') : apply('b64', payload, 'encode');
}

async function handleCallback(cq, deps) {
  const data = String(cq.data || '');
  if (!data.startsWith('code:')) return false;
  await deps.answerCallback(cq.id);
  const chatId = cq.message && cq.message.chat && cq.message.chat.id;
  if (!chatId) return true;
  const key = data.slice(5);
  const user = cq.from || {};
  if (key === 'menu') {
    await deps.telegram('sendMessage', { chat_id: chatId, text: 'Ну цто, чудила, какой замок ты хотеть вскрыть? Выбирать 🤗', reply_markup: { inline_keyboard: MENU } });
    return true;
  }
  const cipher = key === 'auto' ? 'auto' : (CIPHERS[key] ? key : null);
  if (!cipher) {
    await deps.sendMessage(chatId, pingOf(user) + ', такой замок мне не знаком, тыкать нормальную кнопку 🤭');
    return true;
  }
  await setWait(chatId, user.id, cipher === 'caesar' ? 'caesar:3' : cipher);
  const text = cipher === 'auto'
    ? pingOf(user) + ', кидай сюда свою абракадабру следующим сообщением, я сама понять, что за код. Три минуты, потом я забыть 🤭'
    : pingOf(user) + ', выбран ' + CIPHERS[cipher].name + '. Кидай текст следующим сообщением. Цезарь - можно сначала число сдвига, потом текст. Три минуты ☺️';
  await deps.sendMessage(chatId, text);
  return true;
}

async function handleMessage(msg, deps) {
  const text = String(msg.text || msg.caption || '').trim();
  if (!text) return false;
  const chatId = msg.chat.id;
  const user = msg.from || {};
  const isGroup = msg.chat.type === 'group' || msg.chat.type === 'supergroup';
  const cmd = parseCommand(text);

  if (cmd) {
    if (cmd.bot && deps.botUsername && cmd.bot !== deps.botUsername) return false;
    if (!cmd.cipher && !cmd.payload) {
      await deps.telegram('sendMessage', {
        chat_id: chatId,
        text: 'Ну цто, чудила, какой замок ты хотеть вскрыть? Выбирать, пока мой голова не остыть 🤗',
        reply_markup: { inline_keyboard: MENU }
      });
      await deps.memory.logIncoming(chatId, [{ r: 'u', t: '[' + (user.first_name || user.username || 'Аноним') + ']: /code' }], { type: isGroup ? 'group' : 'private', user });
      return true;
    }
    if (!cmd.payload) {
      const waitVal = cmd.cipher ? (cmd.cipher === 'caesar' ? 'caesar:' + (cmd.shift || 3) : cmd.cipher) : 'auto';
      await setWait(chatId, user.id, waitVal);
      await deps.sendMessage(chatId, pingOf(user) + ', и что мне шифровать? Кидай текст следующим сообщением, я ждать три минуты ☺️');
      return true;
    }
    const r = resolve(cmd.cipher, cmd.payload, cmd.shift);
    if (!r) {
      await deps.sendMessage(chatId, pingOf(user) + ', это не шифр, это мусор, мой компьютер такое не жевать 🤭');
      return true;
    }
    await sendResult(deps, msg, r, deps.deadline);
    return true;
  }

  if (text.startsWith('/')) return false;
  const waiting = await getWait(chatId, user.id);
  if (!waiting) return false;
  await clearWait(chatId, user.id);
  let r;
  if (waiting === 'auto') r = resolve(null, text);
  else {
    const parts = String(waiting).split(':');
    const key = parts[0];
    let shift = parts[1] ? clampShift(parts[1]) : null;
    let payload = text;
    if (key === 'caesar') {
      const sm = /^(\d{1,2})\s+([\s\S]+)$/.exec(text);
      if (sm) { shift = clampShift(sm[1]); payload = sm[2].trim(); }
    }
    r = apply(key, payload, null, shift);
  }
  if (!r) {
    await deps.sendMessage(chatId, pingOf(user) + ', я это жевать не стала, там нечего вскрывать 🤭');
    return true;
  }
  await sendResult(deps, msg, r, deps.deadline);
  return true;
}

async function autoCrack(msg, deps) {
  const text = String(msg.text || msg.caption || '').trim();
  if (!text || text.startsWith('/')) return false;
  const d = detect(text);
  if (!d) return false;
  const r = apply(d.cipher, text, 'decode');
  if (!r) return false;
  await sendResult(deps, msg, r, deps.deadline);
  return true;
}

module.exports = { handleCallback, handleMessage, autoCrack, detect, apply, classify, CIPHERS, MENU, parseCommand };
